---
import { Image } from 'astro:assets';
import { getImageDimensions } from '../lib/imageMetadata';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'img'> {
  src: string;
  alt: string;
}
const { src, alt, sizes = '(max-width: 960px) 100vw, 50vw', loading = 'lazy', ...attributes } = Astro.props;
const dimensions = await getImageDimensions(src);
const widths = [320, 480, 640, 768, 960, 1200, 1600, 1920].filter(width => width <= (dimensions?.width ?? 0));
---
{dimensions ? (
  <Image
    {...attributes}
    src={src}
    alt={alt}
    width={dimensions.width}
    height={dimensions.height}
    widths={widths.length ? widths : [320]}
    sizes={sizes}
    format="webp"
    quality={80}
    loading={loading}
    decoding="async"
  />
) : (
  <img {...attributes} src={src} alt={alt} sizes={sizes} loading={loading} decoding="async" />
)}
